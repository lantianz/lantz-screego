LANTZ_SCREEGO_IMAGE=ghcr.io/lantianz/lantz-screego:0.0.2
LANTZ_SCREEGO_VERSION=0.0.2
LANTZ_SCREEGO_CONTAINER_NAME=lantz-screego

SCREEGO_SECRET=replace-with-a-long-random-secret
SCREEGO_EXTERNAL_IP=dns:share.example.com
SCREEGO_SERVER_ADDRESS=127.0.0.1:5050
SCREEGO_TURN_ADDRESS=0.0.0.0:3478
SCREEGO_TURN_EXTERNAL_PORT=3478
SCREEGO_TURN_DENY_PEERS=0.0.0.0/8,127.0.0.1/8,::/128,::1/128,fe80::/10
SCREEGO_AUTH_MODE=none
SCREEGO_CLOSE_ROOM_WHEN_OWNER_LEAVES=true
SCREEGO_TRUST_PROXY_HEADERS=true
SCREEGO_LOG_LEVEL=info
